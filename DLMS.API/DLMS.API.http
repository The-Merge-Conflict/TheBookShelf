Authorization: Bearer {{token}}
Content-Type: application/json

{
  "resourceId": 1,
  "propertyId": 1,
  "valueText": "A standalone value",
  "valueUri": null,
  "valueResourceId": null,
  "valueType": 0,
  "language": { "code": "en" }
}

###
# Get values by resource id.
# Expect: 200 OK
GET {{baseUrl}}/api/values/by-resource/1
Authorization: Bearer {{token}}

###
# Get the individual value by id.
# Expect: 200 OK
GET {{baseUrl}}/api/values/3
Authorization: Bearer {{token}}

###
# Update the individual value.
# Expect: 204 No Content
PUT {{baseUrl}}/api/values/3
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "valueText": "An updated standalone value",
  "valueUri": null,
  "valueResourceId": null,
  "valueType": 0,
  "language": { "code": "en" }
}

###
# Delete the individual value before cleanup.
# Expect: 204 No Content
DELETE {{baseUrl}}/api/values/3
Authorization: Bearer {{token}}

###
# Upload media for the item.
# NOTE: Place a sample image at DLMS.API/test-assets/cover.jpg before running this request
# Expect: 201 Created with body { "id": 1 }
POST {{baseUrl}}/api/media
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=--boundary

----boundary
Content-Disposition: form-data; name="itemId"

1002
----boundary
Content-Disposition: form-data; name="altText"

Cover image of The Great Gatsby
----boundary
Content-Disposition: form-data; name="file"; filename="cover.jpg"
Content-Type: image/jpeg

< ./test-assets/cover.jpg
----boundary--

###
# Get media by item id.
# Expect: 200 OK
GET {{baseUrl}}/api/media/by-item/1002
Authorization: Bearer {{token}}

###
# Delete uploaded media before deleting the item.
# Expect: 204 No Content
DELETE {{baseUrl}}/api/media/1003
Authorization: Bearer {{token}}

###
# Delete the item.
# Expect: 204 No Content
DELETE {{baseUrl}}/api/items/1002
Authorization: Bearer {{token}}

###
# Delete the item set.
# Expect: 204 No Content
DELETE {{baseUrl}}/api/itemsets/1
Authorization: Bearer {{token}}

###
# Delete the resource template.
# Expect: 204 No Content
DELETE {{baseUrl}}/api/resourcetemplates/1
Authorization: Bearer {{token}}

###
# Delete the title property.
# Expect: 204 No Content
DELETE {{baseUrl}}/api/properties/1
Authorization: Bearer {{token}}

###
# Delete the creator property.
# Expect: 204 No Content
DELETE {{baseUrl}}/api/properties/2
Authorization: Bearer {{token}}

###
# Delete the vocabulary.
# Expect: 204 No Content
DELETE {{baseUrl}}/api/vocabularies/1
Authorization: Bearer {{token}}
